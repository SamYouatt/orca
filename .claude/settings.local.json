{
  "permissions": {
    "allow": [
      "Bash(zellij --version)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:zellij.dev)",
      "WebFetch(domain:plannotator.ai)",
      "Bash(git:*)",
      "Bash(rustc --version)",
      "Bash(cargo --version)",
      "Bash(cargo add:*)",
      "Bash(cargo build:*)",
      "Bash(cargo test:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(sqlite3:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/samyouatt/Developer/orca/orca-cli/scripts/stop-hook-rust.sh",
            "timeout": 120,
            "statusMessage": "Running rustfmt on changed files + cargo clippy..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/samyouatt/Developer/orca/orca-cli/scripts/stop-hook-rust.sh",
            "timeout": 120,
            "statusMessage": "Running rustfmt on changed files + cargo clippy..."
          }
        ]
      }
    ]
  }
}
